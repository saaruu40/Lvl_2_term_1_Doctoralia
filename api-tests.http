# =============================================================================
# 2. DEPARTMENT APIs — server/routes/departmentRoutes.js + server/controllers/departmentController.js
#    ALSO admin-scoped variant at /api/admin/departments (see Section 5A.9)
# =============================================================================
# Public reads: GET / and GET /:id — used by Doctor Registration dropdown & Patient browsing.
# Protected writes: POST / , PUT /:id , DELETE /:id — 🔒 Requires admin token (roleMiddleware "admin")
# Headers for protected: Authorization: Bearer {{adminToken}}  Content-Type: application/json
# =============================================================================

### 2.1 Department — List all — Public (NO TOKEN) ✅ Required for Doctor Registration
# GET /api/departments?search=Cardio (optional, case-insensitive LIKE)
# Expected 200: { "message": "Departments fetched successfully.", "departments": [ { "department_id", "department_name", "description", "status" } ] }
GET {{baseUrl}}/api/departments

### 2.2 Department — Search filter — Public
GET {{baseUrl}}/api/departments?search=Cardio

### 2.3 Department — Get by ID — Public
# Expected 200: { "department": { "department_id":1, "department_name":"Cardiology", ... } }  404 if not found
GET {{baseUrl}}/api/departments/1

### 2.4 Department — Create — 🔒 Requires admin token
# POST /api/departments — Body: { "department_name" (required), "description" }
# Expected 201: { "message": "Department created successfully.", "department": { ... } }
# Expected 400: missing name | 409: duplicate (LOWER check)
POST {{baseUrl}}/api/departments
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "department_name": "Nephrology",
  "description": "Kidney and renal system disorders"
}

### 2.5 Department — Update — 🔒 Requires admin token
# PUT /api/departments/:id — Body: { "department_name", "description" } — COALESCE semantics (null keeps old value)
# Expected 200: { "message": "Department updated successfully.", "department": { ... } }  409 duplicate
PUT {{baseUrl}}/api/departments/1
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "department_name": "Cardiology Updated",
  "description": "Heart and cardiovascular system - updated"
}

### 2.6 Department — Delete — 🔒 Requires admin token — blocked if doctors assigned
# DELETE /api/departments/:id
# Expected 200: { "message": "Department deleted successfully." }  409 if doctors exist  404 not found
DELETE {{baseUrl}}/api/departments/5
Authorization: Bearer {{adminToken}}

# =============================================================================
# 3. DOCTOR — PROTECTED ROUTES (server/routes/doctorRoutes.js:244 — router.use(auth+role doctor))
#    All below require: Authorization: Bearer {{doctorToken}}  role "doctor"
#    Extra guards: getActiveDoctor() checks approved + suspended_until auto-clear.
# =============================================================================

### 3.1 Doctor — Get own profile — 🔒 doctor
# GET /api/doctors/profile — uses req.user.doctor_id, joins department
# Expected 200: { "doctor": { "doctor_id", "full_name", "email", "department_name", ... } }
GET {{baseUrl}}/api/doctors/profile
Authorization: Bearer {{doctorToken}}

### 3.2 Doctor — Dashboard stats — 🔒 doctor
# GET /api/doctors/dashboard/stats — counts confirmed/completed appointments, prescriptions, received referrals
# Expected 200: { "confirmedAppointments": 3, "completedAppointments": 5, "totalPrescriptions": 2, "receivedReferrals": 1 }
GET {{baseUrl}}/api/doctors/dashboard/stats
Authorization: Bearer {{doctorToken}}

### 3.3 Doctor — List own appointments (with optional schedule_id filter) — 🔒 doctor
# GET /api/doctors/appointments?schedule_id=1 (optional — if present verifies doctor owns schedule)
# Joins patient/hospital/schedule/payment/prescription/referral — ordered confirmed->scheduled->pending->completed
# Expected 200: { "appointments": [ { "appointment_id", "patient_name", "hospital_name", "available_date", "payment_status", ... } ] }
GET {{baseUrl}}/api/doctors/appointments
Authorization: Bearer {{doctorToken}}

### 3.4 Doctor — Appointments filtered by schedule — 🔒 doctor
GET {{baseUrl}}/api/doctors/appointments?schedule_id=1
Authorization: Bearer {{doctorToken}}

### 3.5 Doctor — List medicines — 🔒 doctor
# GET /api/doctors/medicines — SELECT * FROM medicine ORDER BY medicine_name
# Expected 200: { "medicines": [ { "medicine_id", "medicine_name", "strength", "medicine_type" } ] }
GET {{baseUrl}}/api/doctors/medicines
Authorization: Bearer {{doctorToken}}

### 3.6 Doctor — List tests — 🔒 doctor
# GET /api/doctors/tests — SELECT * FROM test ORDER BY test_name
# Expected 200: { "tests": [ { "test_id", "test_name", "description", "estimated_cost" } ] }
GET {{baseUrl}}/api/doctors/tests
Authorization: Bearer {{doctorToken}}

### 3.7 Doctor — Create prescription — 🔒 doctor — transactional + capacity
# POST /api/doctors/prescriptions — Appointment must be 'confirmed' and belong to doctor, not already prescribed (409).
# Body: { "appointment_id" (required), "diagnosis" (required trimmed), "advice" (optional), "medicines": [{ "medicine_id" (required), "dosage", "frequency", "duration", "instruction" }], "tests": [{ "test_id" }] }
# Inserts prescription + prescription_medicine (dedup Set, verify exists 400) + prescription_test + UPDATE appointment SET completed
# Fires DB trigger trg_prescription_notification -> patient notification
# Expected 201: { "message": "Prescription created successfully. Appointment completed.", "prescription": { ... } }
POST {{baseUrl}}/api/doctors/prescriptions
Content-Type: application/json
Authorization: Bearer {{doctorToken}}

{
  "appointment_id": 1,
  "diagnosis": "Acute viral fever with mild dehydration",
  "advice": "Take rest for 3 days, drink plenty of fluids, follow up if fever persists.",
  "medicines": [
    {
      "medicine_id": 1,
      "dosage": "500mg",
      "frequency": "3 times daily",
      "duration": "5 days",
      "instruction": "After meal"
    },
    {
      "medicine_id": 2,
      "dosage": "20mg",
      "frequency": "Once daily",
      "duration": "7 days",
      "instruction": "Before breakfast"
    }
  ],
  "tests": [
    { "test_id": 1 },
    { "test_id": 2 }
  ]
}

### 3.8 Doctor — List referral targets (approved doctors except self) — 🔒 doctor
# GET /api/doctors/referral-doctors — only approved + not suspended, excludes self
GET {{baseUrl}}/api/doctors/referral-doctors
Authorization: Bearer {{doctorToken}}

### 3.9 Doctor — Create referral — 🔒 doctor
# POST /api/doctors/referrals — cannot self-refer, appointment must be confirmed/completed and belong to doctor, not already referred (409), target must be approved not suspended.
# Body: { "appointment_id" (required), "referred_to" (doctor_id required), "reason" (required trimmed) }
# Fires DB trigger trg_referral_notification -> patient notification
# Expected 201: { "message": "Patient referred successfully.", "referral": { ... } }
POST {{baseUrl}}/api/doctors/referrals
Content-Type: application/json
Authorization: Bearer {{doctorToken}}

{
  "appointment_id": 1,
  "referred_to": 2,
  "reason": "Patient requires specialized neurological evaluation — please review ECG and prescribe further care."
}

### 3.10 Doctor — Sent referrals — 🔒 doctor
# GET /api/doctors/referrals/sent — WHERE referred_by = self, joins patient + target doctor/department
GET {{baseUrl}}/api/doctors/referrals/sent
Authorization: Bearer {{doctorToken}}

### 3.11 Doctor — Received referrals — 🔒 doctor
# GET /api/doctors/referrals/received — WHERE referred_to = self, joins patient + source doctor/department
GET {{baseUrl}}/api/doctors/referrals/received
Authorization: Bearer {{doctorToken}}

### 3.12 Doctor — Complaint targets (patients of doctor + approved staff) — 🔒 doctor
# GET /api/doctors/complaint-targets — patients = DISTINCT from appointment where doctor_id = self; staff = approved not suspended
GET {{baseUrl}}/api/doctors/complaint-targets
Authorization: Bearer {{doctorToken}}

### 3.13 Doctor — Create complaint — 🔒 doctor
# POST /api/doctors/complaints — Body: { "against_type": "patient"|"staff" (required), "against_id" (required), "appointment_id" (optional, must belong to doctor + patient match), "complaint_type" (required), "description" (required) }
# Inserts filed_by_doctor_id, status pending — fires trg_complaint_admin -> admin 1 notification
# Expected 201: { "complaint": { ... } }
POST {{baseUrl}}/api/doctors/complaints
Content-Type: application/json
Authorization: Bearer {{doctorToken}}

{
  "against_type": "patient",
  "against_id": 1,
  "appointment_id": 1,
  "complaint_type": "Misbehavior",
  "description": "Patient repeatedly missed scheduled follow-up without notice, affecting clinic schedule."
}

### 3.14 Doctor — Create complaint against staff — 🔒 doctor (variant)
POST {{baseUrl}}/api/doctors/complaints
Content-Type: application/json
Authorization: Bearer {{doctorToken}}

{
  "against_type": "staff",
  "against_id": 1,
  "complaint_type": "Unprofessional conduct",
  "description": "Staff member was unavailable during assigned duty hours."
}

### 3.15 Doctor — My complaint history — 🔒 doctor
# GET /api/doctors/complaints — WHERE filed_by_doctor_id = self, joins patient/staff + admin reviewed_by
GET {{baseUrl}}/api/doctors/complaints
Authorization: Bearer {{doctorToken}}

# -------------------------------------------------------------------------
# 3D. DOCTOR — SCHEDULE MANAGEMENT — 🔒 doctor — Window 12:55-18:00 Asia/Dhaka (server/utils/scheduleWindow.js:6)
#     Dates: tomorrow .. Dec 31 of same year (assertTargetDateInSameYear) — time HH:MM 24h regex ^([01]\d|2[0-3]):([0-5]\d)$
# -------------------------------------------------------------------------

### 3D.1 Doctor — Hospitals (for schedule create) — 🔒 doctor
# GET /api/doctors/hospitals — SELECT hospital_id, hospital_name, city, address
GET {{baseUrl}}/api/doctors/hospitals
Authorization: Bearer {{doctorToken}}

### 3D.2 Doctor — Schedule window info — 🔒 doctor
# GET /api/doctors/schedules/window — returns { timezone:"Asia/Dhaka", targetDate, currentDate, isOpen, currentTime, window:"12:55-18:00" }
GET {{baseUrl}}/api/doctors/schedules/window
Authorization: Bearer {{doctorToken}}

### 3D.3 Doctor — List my schedules (own only) — 🔒 doctor
# GET /api/doctors/schedules — WHERE ds.doctor_id = self AND s.available_date BETWEEN targetDate AND Dec31, enriched is_expired/computed_status/is_tomorrow/is_editable
GET {{baseUrl}}/api/doctors/schedules
Authorization: Bearer {{doctorToken}}

### 3D.4 Doctor — Create schedule — 🔒 doctor — ONLY when window open (12:55-18:00) else 403 WINDOW_CLOSED
# POST /api/doctors/schedules — Body: { "available_date" (YYYY-MM-DD, default targetDate, must be tomorrow..Dec31 same year), "start_time" HH:MM (required), "end_time" HH:MM (required, > start), "hospital_id" (required, must exist), "status"/"slot_status" "AVAILABLE"|"WORKING"|"UNAVAILABLE" default AVAILABLE }
# Checks overlap, duplicate doctor+date+time+hospital, shared global schedule row reuse, doctor_schedule insert.
# Expected 201: { schedule }  400 invalid time/date  403 window closed  409 overlap/duplicate
POST {{baseUrl}}/api/doctors/schedules
Content-Type: application/json
Authorization: Bearer {{doctorToken}}

{
  "available_date": "2026-09-24",
  "start_time": "10:00",
  "end_time": "11:00",
  "hospital_id": 1,
  "status": "AVAILABLE"
}

### 3D.5 Doctor — Create schedule (minimal — defaults to tomorrow) — 🔒 doctor
POST {{baseUrl}}/api/doctors/schedules
Content-Type: application/json
Authorization: Bearer {{doctorToken}}

{
  "start_time": "14:00",
  "end_time": "15:00",
  "hospital_id": 1
}

### 3D.6 Doctor — Update own schedule — 🔒 doctor — window + tomorrow + not expired + not WORKING
# PUT /api/doctors/schedules/:id — Params :id schedule_id — Body same as create (available_date, start_time, end_time, hospital_id, status)
# Verified owned via JOIN doctor_schedule, assertTargetDateInSameYear, !isSlotExpired, slot_status != WORKING, overlap excludeScheduleId, shared-slot detach creates new schedule row
PUT {{baseUrl}}/api/doctors/schedules/1
Content-Type: application/json
Authorization: Bearer {{doctorToken}}

{
  "available_date": "2026-09-24",
  "start_time": "09:00",
  "end_time": "10:00",
  "hospital_id": 1,
  "status": "AVAILABLE"
}

### 3D.7 Doctor — Toggle availability — 🔒 doctor
# PATCH /api/doctors/schedules/:id/availability — Body: { "status" or "slot_status": "AVAILABLE"|"WORKING"|"UNAVAILABLE" (required) }
# Same guards as update; blocks UNAVAILABLE if WORKING with appointments.
PATCH {{baseUrl}}/api/doctors/schedules/1/availability
Content-Type: application/json
Authorization: Bearer {{doctorToken}}

{
  "status": "UNAVAILABLE"
}

### 3D.8 Doctor — Toggle back to available — 🔒 doctor
PATCH {{baseUrl}}/api/doctors/schedules/1/availability
Content-Type: application/json
Authorization: Bearer {{doctorToken}}

{
  "slot_status": "AVAILABLE"
}

### 3D.9 Doctor — Delete own slot — 🔒 doctor — not expired, not WORKING, no scheduled/confirmed appointments (409 if exists)
# DELETE /api/doctors/schedules/:id — deletes doctor_schedule, if no remaining links deletes schedule row.
DELETE {{baseUrl}}/api/doctors/schedules/1
Authorization: Bearer {{doctorToken}}

# -------------------------------------------------------------------------
# 3E. DOCTOR — STAFF ASSIGNMENT — 🔒 doctor  (Primary + Temporary) — server/utils/staffAssignmentHelper.js
# -------------------------------------------------------------------------

### 3E.1 Doctor — My staff (primary + temporary) — 🔒 doctor
# GET /api/doctors/my-staff — returns { primary: assignment|null, temporary: ..., hasPrimary, hasTemporary, is_suspended } — cleanup expired assigns/suspensions
GET {{baseUrl}}/api/doctors/my-staff
Authorization: Bearer {{doctorToken}}

### 3E.2 Doctor — Available staff (approved, not suspended, not assigned) — 🔒 doctor
GET {{baseUrl}}/api/doctors/available-staff
Authorization: Bearer {{doctorToken}}

### 3E.3 Doctor — Assign staff — 🔒 doctor
# POST /api/doctors/assign-staff — Body: { "staff_id" (required) } — Transaction FOR UPDATE staff, checks approved not suspended, no active assignment for staff, primary/temporary logic: if no primary -> PRIMARY end_date NULL, if primary suspended + no temp -> TEMPORARY end_date = primary.suspended_until, else 409. Unique 23505 caught.
# Expected 201: assignment  409 already assigned / has staff
POST {{baseUrl}}/api/doctors/assign-staff
Content-Type: application/json
Authorization: Bearer {{doctorToken}}

{
  "staff_id": 1
}

### 3E.4 Doctor — Add medicine (catalog) — 🔒 doctor — note double authMiddleware in route (redundant)
# POST /api/doctors/add-medicine — Body: { "medicine_name" (required), "strength", "medicine_type" } — INSERT INTO medicine
POST {{baseUrl}}/api/doctors/add-medicine
Content-Type: application/json
Authorization: Bearer {{doctorToken}}

{
  "medicine_name": "Napa Extra",
  "strength": "500mg",
  "medicine_type": "Tablet"
}

### 3E.5 Doctor — Add test (catalog) — 🔒 doctor
# POST /api/doctors/add-test — Body: { "test_name" (required), "description", "estimated_cost" } — INSERT INTO test
POST {{baseUrl}}/api/doctors/add-test
Content-Type: application/json
Authorization: Bearer {{doctorToken}}

{
  "test_name": "Blood Sugar Fasting",
  "description": "Fasting blood glucose level",
  "estimated_cost": 350.00
}

