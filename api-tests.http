# --- Appointment & Payment — Public but with ownership checks inside controller ---

### 5.13 Patient — Create appointment — Public (⚠️ no auth, but validates patient/doctor/schedule + capacity + duplicate 409 + expired slot)
# POST /api/patients/appointments — Body: { "patient_id" (required), "doctor_id" (required), "schedule_id" (required), "hospital_id" (optional fallback slot.hospital_id) }
# Locks patient FOR UPDATE (suspended check), doctor FOR UPDATE (approved+not suspended), schedule JOIN doctor_schedule FOR UPDATE (AVAILABLE+not expired), duplicate pending/scheduled/confirmed 409, capacity max_patient_num 409, INSERT pending
# Expected 201: { "message": "Appointment request submitted successfully.", "appointment": { "appointment_id", "appointment_status":"pending", ... } }
POST {{baseUrl}}/api/patients/appointments
Content-Type: application/json

{
  "patient_id": 1,
  "doctor_id": 1,
  "schedule_id": 1,
  "hospital_id": 1
}

### 5.14 Patient — List own appointments — Public (⚠️ :patientId in path, no ownership token check)
# GET /api/patients/:patientId/appointments — JOIN doctor/department/hospital/schedule/payment ORDER appointment_id DESC
GET {{baseUrl}}/api/patients/1/appointments

### 5.15 Patient — Cancel pending appointment — Public (⚠️ no ownership check, just status pending)
# DELETE /api/patients/appointments/:id — DELETE WHERE status pending RETURNING 404 if not pending
DELETE {{baseUrl}}/api/patients/appointments/1

### 5.16 Patient — Make payment — Public (⚠️ should require patient token; controller does patient_id == appointment.patient_id check)
# POST /api/patients/payments — Body: { "patient_id" (required), "appointment_id" (required), "payment_method" (required e.g. "bkash","cash","card") }
# Validates not suspended, locks appointment FOR UPDATE OF a, checks belongs to patient 403, status scheduled else 400, unavailable/expired 400, already paid 409, picks new_patient_fee vs followup_fee via EXISTS completed, INSERT payment paid + UPDATE appointment confirmed
# Fires DB trigger trg_payment_success -> patient notification; trg_appointment_status_notification -> 'confirmed'
# Expected 201: { "message": "Payment successful. Appointment confirmed.", "fee_type": "new_patient"|"followup", "amount": 800, "payment": { ... } }
POST {{baseUrl}}/api/patients/payments
Content-Type: application/json

{
  "patient_id": 1,
  "appointment_id": 1,
  "payment_method": "bkash"
}

### 5.17 Patient — Create complaint — Public
# POST /api/patients/complaints — Body: { "patient_id" (required), "against_type":"doctor"|"staff" (required), "against_id" (required), "appointment_id" (optional), "complaint_type" (required), "description" (required) } — checks patient not suspended, maps against_doctor/staff, filed_by_patient_id, pending — fires trg_complaint_admin
POST {{baseUrl}}/api/patients/complaints
Content-Type: application/json

{
  "patient_id": 1,
  "against_type": "doctor",
  "against_id": 1,
  "appointment_id": 1,
  "complaint_type": "Rude behavior",
  "description": "Doctor was dismissive during consultation and did not explain diagnosis properly."
}

