# 4. STAFF — server/routes/staffRoutes.js + server/controllers/staffController.js
#    Public: GET /status, POST /apply, POST /login  |  Protected 🔒 staff: everything after router.use(auth, role staff)
# =============================================================================

### 4.1 Staff — Get own profile — 🔒 staff
# GET /api/staff/profile — req.user.staff_id -> getActiveStaff (approved + not suspended)
GET {{baseUrl}}/api/staff/profile
Authorization: Bearer {{staffToken}}

### 4.2 Staff — My assignment — 🔒 staff
# GET /api/staff/my-assignment — cleanup assignments, join doctor — returns { assignment: null|row }
GET {{baseUrl}}/api/staff/my-assignment
Authorization: Bearer {{staffToken}}

### 4.3 Staff — Dashboard stats — 🔒 staff
# GET /api/staff/dashboard/stats — finds doctorId from ACTIVE staff_assignment, counts pending/scheduled/confirmed appointments + filed complaints
GET {{baseUrl}}/api/staff/dashboard/stats
Authorization: Bearer {{staffToken}}

### 4.4 Staff — List appointments (assigned doctor) — 🔒 staff
# GET /api/staff/appointments — requires active assignment else { appointments:[], assigned:false }; joins patient/doctor/department/hospital/schedule/payment + remaining_slots = max_patient_num - booked
GET {{baseUrl}}/api/staff/appointments
Authorization: Bearer {{staffToken}}

### 4.5 Staff — Hospitals — 🔒 staff
GET {{baseUrl}}/api/staff/hospitals
Authorization: Bearer {{staffToken}}

### 4.6 Staff — Available schedules for a doctor (read-only) — 🔒 staff
# GET /api/staff/available-schedules?doctor_id=1 — query doctor_id required, verifies staff assignment to that doctor, returns ds.status AVAILABLE filtered !isSlotExpired
GET {{baseUrl}}/api/staff/available-schedules?doctor_id=1
Authorization: Bearer {{staffToken}}

### 4.7 Staff — Assign hospital + schedule to appointment — 🔒 staff — staff cannot create doctor slots, only pick existing
# PATCH /api/staff/appointments/:id/schedule — Body: { "hospital_id" (required), "schedule_id" (required) }
# Verifies ACTIVE assignment to appointment's doctor, pending/scheduled status, doctor not suspended, hospital exists, slot FOR UPDATE, slot_status != UNAVAILABLE, not expired, capacity max_patient_num
# Expected 200: updated appointment  403 not assigned  400 unavailable/expired  409 capacity full
PATCH {{baseUrl}}/api/staff/appointments/1/schedule
Content-Type: application/json
Authorization: Bearer {{staffToken}}

{
  "hospital_id": 1,
  "schedule_id": 1
}

### 4.8 Staff — Approve appointment (pending -> scheduled) — 🔒 staff
# PATCH /api/staff/appointments/:id/approve — lock appointment JOIN doctor, status pending, schedule_id not null, lock schedule FOR UPDATE, check UNAVAILABLE/expired, capacity < max_patient_num, UPDATE status scheduled — returns capacity { max, booked+1, remaining }
PATCH {{baseUrl}}/api/staff/appointments/1/approve
Authorization: Bearer {{staffToken}}

### 4.9 Staff — Reject appointment — 🔒 staff
# PATCH /api/staff/appointments/:id/reject — similar guards -> UPDATE status rejected, cancelled_by_staff_id
PATCH {{baseUrl}}/api/staff/appointments/1/reject
Authorization: Bearer {{staffToken}}

### 4.10 Staff — Complaint targets (patients + doctors) — 🔒 staff
# GET /api/staff/complaint-targets — { patients: all patient_id/full_name/email/phone, doctors: approved not suspended with department }
GET {{baseUrl}}/api/staff/complaint-targets
Authorization: Bearer {{staffToken}}

### 4.11 Staff — Create complaint — 🔒 staff
# POST /api/staff/complaints — Body: { "against_type":"patient"|"doctor" (required), "against_id" (required), "appointment_id" (optional, must exist), "complaint_type" (required), "description" (required) } — verified existence, pending
POST {{baseUrl}}/api/staff/complaints
Content-Type: application/json
Authorization: Bearer {{staffToken}}

{
  "against_type": "patient",
  "against_id": 1,
  "appointment_id": 1,
  "complaint_type": "No-show",
  "description": "Patient did not appear for scheduled appointment after confirmation."
}

### 4.12 Staff — Complaint history — 🔒 staff
# GET /api/staff/complaints — WHERE filed_by_staff_id = self, joins patient/doctor/admin
GET {{baseUrl}}/api/staff/complaints
Authorization: Bearer {{staffToken}}

