### 1C.1 Patient — Register — Public
# POST /api/patients/register — all fields required.
# Body: { full_name, email (unique), password, phone_number, gender, date_of_birth (YYYY-MM-DD), blood_group, address }
# Expected 201: { "message": "Patient registration successful.", "patient": { "patient_id", ... } }
# Expected 409: email already exists — fires DB trigger trg_patient_registration -> Welcome notification
POST {{baseUrl}}/api/patients/register
Content-Type: application/json

{
  "full_name": "Moriom Akter",
  "email": "moriom.patient@example.com",
  "password": "Patient@123",
  "phone_number": "01720000001",
  "gender": "Female",
  "date_of_birth": "1998-05-12",
  "blood_group": "A+",
  "address": "Dhanmondi, Dhaka"
}

### 1C.2 Patient — Login — Public — ⭐ RETURNS TOKEN (save as {{patientToken}})
# POST /api/patients/login — clears expired suspension, blocks active suspension 403.
# Body: { "email", "password" } -> jwt { patient_id, role:"patient" }
# Expected 200: { "message": "Login successful.", "token": "eyJ...", "patient": { ... } }
# @name patientLogin
POST {{baseUrl}}/api/patients/login
Content-Type: application/json

{
  "email": "moriom.patient@example.com",
  "password": "Patient@123"
}

