# -------------------------------------------------------------------------
# 4. Staff — Complaints — PROTECTED — STAFF JWT — fires trg_complaint_admin
# -------------------------------------------------------------------------

### 4.1 Complaint targets — PROTECTED — STAFF JWT — GET /api/staff/complaint-targets
# A. Valid Staff token → 200
GET {{baseUrl}}/api/staff/complaint-targets
Authorization: Bearer {{staffToken}}

### 4.1B No token → 401
GET {{baseUrl}}/api/staff/complaint-targets

### 4.1C Invalid token → 401
GET {{baseUrl}}/api/staff/complaint-targets
Authorization: Bearer invalid-token

### 4.1D Wrong role (Patient) → 403
GET {{baseUrl}}/api/staff/complaint-targets
Authorization: Bearer {{patientToken}}

### 4.2 Create complaint via Staff endpoint — PROTECTED — STAFF JWT — POST /api/staff/complaints
# Staff complaint must use POST /api/staff/complaints (🔒 staff, filed_by_id from req.user.staff_id)
# Body does NOT contain filed_by_type/filed_by_id — taken from JWT
# A. Valid Staff token → 201
POST {{baseUrl}}/api/staff/complaints
Content-Type: application/json
Authorization: Bearer {{staffToken}}

{
  "against_type": "patient",
  "against_id": 1,
  "appointment_id": 1,
  "complaint_type": "No-show",
  "description": "Patient did not appear for scheduled appointment after confirmation."
}

### 4.2B No token → 401
POST {{baseUrl}}/api/staff/complaints
Content-Type: application/json

{
  "against_type": "patient",
  "against_id": 1,
  "complaint_type": "No-show",
  "description": "Patient did not appear."
}

### 4.2C Invalid token → 401
POST {{baseUrl}}/api/staff/complaints
Content-Type: application/json
Authorization: Bearer invalid-token

{
  "against_type": "patient",
  "against_id": 1,
  "complaint_type": "No-show",
  "description": "Patient did not appear."
}

### 4.2D Wrong role (Doctor) → 403
POST {{baseUrl}}/api/staff/complaints
Content-Type: application/json
Authorization: Bearer {{doctorToken}}

{
  "against_type": "patient",
  "against_id": 1,
  "complaint_type": "No-show",
  "description": "Patient did not appear."
}

### 4.2E Spoof attempt — filed_by_id from JWT, not body (use staff endpoint, body filed_by_id ignored if sent)
# Try to spoof: send filed_by_id 999, backend must use req.user.staff_id={{staffId}}, not 999
POST {{baseUrl}}/api/staff/complaints
Content-Type: application/json
Authorization: Bearer {{staffToken}}

{
  "against_type": "doctor",
  "against_id": 1,
  "complaint_type": "Unprofessional conduct",
  "description": "Doctor was late for scheduled consultation without notice."
}

### 4.3 Alternative — against doctor — PROTECTED — STAFF JWT
POST {{baseUrl}}/api/staff/complaints
Content-Type: application/json
Authorization: Bearer {{staffToken}}

{
  "against_type": "doctor",
  "against_id": 1,
  "complaint_type": "Unprofessional conduct",
  "description": "Doctor was late for scheduled consultation without notice."
}

### 4.4 Complaint history — PROTECTED — STAFF JWT — GET /api/staff/complaints
# A. Valid Staff token → 200
GET {{baseUrl}}/api/staff/complaints
Authorization: Bearer {{staffToken}}

### 4.4B No token → 401
GET {{baseUrl}}/api/staff/complaints

### 4.4C Invalid token → 401
GET {{baseUrl}}/api/staff/complaints
Authorization: Bearer invalid-token

### 4.4D Wrong role (Doctor) → 403
GET {{baseUrl}}/api/staff/complaints
Authorization: Bearer {{doctorToken}}

### 4.5 Generic complaint via POST /api/complaints — DEPRECATED for Staff
# DEPRECATED for Staff — Staff must use POST /api/staff/complaints (🔒 staff)
# Generic endpoint kept for backward compat (patient/doctor) but NOT recommended for Staff
POST {{baseUrl}}/api/complaints
Content-Type: application/json

{
  "filed_by_type": "staff",
  "filed_by_id": 1,
  "against_type": "patient",
  "against_id": 1,
  "complaint_type": "No-show",
  "description": "Patient did not appear for scheduled appointment."
}

