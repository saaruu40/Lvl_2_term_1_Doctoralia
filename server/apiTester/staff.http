# Base: http://localhost:5000
# Routes: server/routes/staffRoutes.js + server/controllers/staffController.js
# Auth: JWT Bearer â€” role "staff", server/middleware/authMiddleware.js
# Multer: uploads/staff, field profile_pic, 5MB, jpeg/jpg/png/webp
#
# HOW TO USE:
#  1. POST /api/staff/login â†’ copy token â†’ paste into @staffToken
#  2. Every ðŸ”’ block below sends Authorization: Bearer {{staffToken}}
