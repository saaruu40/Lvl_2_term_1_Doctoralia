# =============================================================================
# Staff — All Operations — Doctoralia
# =============================================================================
# Base: http://localhost:5000
# Routes: server/routes/staffRoutes.js + server/controllers/staffController.js
# Auth: JWT Bearer — role "staff", server/middleware/authMiddleware.js + roleMiddleware("staff")
# Multer: uploads/staff, field profile_pic, 5MB, jpeg/jpg/png/webp
#
# HOW TO USE:
#  1. POST /api/staff/login → copy token → paste into @staffToken
#  2. Every 🔒 block below sends Authorization: Bearer {{staffToken}}
#  3. Staff must be approved by admin and assigned to a doctor to manage appointments
#  4. For negative tests, use @staffToken2 (another staff), @doctorToken, @patientToken
# =============================================================================

@baseUrl = http://localhost:5000

@staffToken = PASTE_VALID_STAFF_JWT_HERE
@staffToken2 = PASTE_ANOTHER_STAFF_JWT_HERE
@doctorToken = PASTE_VALID_DOCTOR_JWT_HERE
@patientToken = PASTE_VALID_PATIENT_JWT_HERE

@staffId = 1
@otherStaffId = 2

# -------------------------------------------------------------------------
# 0. Health — PUBLIC
# -------------------------------------------------------------------------

### 0.1 Root — PUBLIC — GET /
GET {{baseUrl}}/

### 0.2 Test DB — PUBLIC — GET /api/test-db
GET {{baseUrl}}/api/test-db

# -------------------------------------------------------------------------
# 1. Staff Auth — PUBLIC
# -------------------------------------------------------------------------

### 1.1 Registration status — PUBLIC — GET /api/staff/status
GET {{baseUrl}}/api/staff/status

### 1.2 Register — PUBLIC — POST /api/staff/apply — multipart profile_pic
POST {{baseUrl}}/api/staff/apply
Content-Type: multipart/form-data; boundary=----WebKitFormBoundaryStaff

------WebKitFormBoundaryStaff
Content-Disposition: form-data; name="email"

staff.nurse@example.com
------WebKitFormBoundaryStaff
Content-Disposition: form-data; name="password"

Staff@123
------WebKitFormBoundaryStaff
Content-Disposition: form-data; name="phone_number"

01730000001
------WebKitFormBoundaryStaff
Content-Disposition: form-data; name="gender"

Female
------WebKitFormBoundaryStaff
Content-Disposition: form-data; name="profile_pic"; filename="staff.jpg"
Content-Type: image/jpeg

< ./server/uploads/staff/staff.jpg
------WebKitFormBoundaryStaff--

### 1.3 Login — PUBLIC — POST /api/staff/login — ⭐ RETURNS TOKEN
# @name staffLogin
POST {{baseUrl}}/api/staff/login
Content-Type: application/json

{
  "email": "staff.nurse@example.com",
  "password": "Staff@123"
}

# -------------------------------------------------------------------------
# 2. Staff — Profile & Assignment — PROTECTED — STAFF JWT
# -------------------------------------------------------------------------

### 2.1 Get own profile — PROTECTED — STAFF JWT — GET /api/staff/profile
# A. Valid Staff token → 200
GET {{baseUrl}}/api/staff/profile
Authorization: Bearer {{staffToken}}

### 2.1B No token → 401
GET {{baseUrl}}/api/staff/profile
# No Authorization — expect 401 { message: "No token provided" }

### 2.1C Invalid token → 401
GET {{baseUrl}}/api/staff/profile
Authorization: Bearer invalid-token
# Expect 401 { message: "Invalid or expired token" }

### 2.1D Wrong role (Doctor) → 403
GET {{baseUrl}}/api/staff/profile
Authorization: Bearer {{doctorToken}}
# Expect 403 { message: "Access denied. You do not have permission." }

### 2.2 My assignment — PROTECTED — STAFF JWT — GET /api/staff/my-assignment
# A. Valid Staff token → 200
GET {{baseUrl}}/api/staff/my-assignment
Authorization: Bearer {{staffToken}}

### 2.2B No token → 401
GET {{baseUrl}}/api/staff/my-assignment
# No Authorization — expect 401

### 2.2C Invalid token → 401
GET {{baseUrl}}/api/staff/my-assignment
Authorization: Bearer invalid-token

### 2.2D Wrong role (Doctor) → 403
GET {{baseUrl}}/api/staff/my-assignment
Authorization: Bearer {{doctorToken}}

### 2.3 Dashboard stats — PROTECTED — STAFF JWT — GET /api/staff/dashboard/stats
# A. Valid Staff token → 200
GET {{baseUrl}}/api/staff/dashboard/stats
Authorization: Bearer {{staffToken}}

### 2.3B No token → 401
GET {{baseUrl}}/api/staff/dashboard/stats

### 2.3C Invalid token → 401
GET {{baseUrl}}/api/staff/dashboard/stats
Authorization: Bearer invalid-token

### 2.3D Wrong role (Patient) → 403
GET {{baseUrl}}/api/staff/dashboard/stats
Authorization: Bearer {{patientToken}}

