  "description": "Fasting blood glucose level",
  "estimated_cost": 350.00
}

# -------------------------------------------------------------------------
# 5. Doctor — Prescription — 🔒 doctor — transactional, fires trg_prescription_notification
# -------------------------------------------------------------------------

### 5.1 Create prescription — 🔒 doctor — POST /api/doctors/prescriptions — confirmed only
POST {{baseUrl}}/api/doctors/prescriptions
Content-Type: application/json
Authorization: Bearer {{doctorToken}}

{
  "appointment_id": 1,
  "diagnosis": "Acute viral fever with mild dehydration",
  "advice": "Take rest for 3 days, drink plenty of fluids.",
  "medicines": [
    { "medicine_id": 1, "dosage": "500mg", "frequency": "3 times daily", "duration": "5 days", "instruction": "After meal" },
    { "medicine_id": 2, "dosage": "20mg", "frequency": "Once daily", "duration": "7 days", "instruction": "Before breakfast" }
  ],
  "tests": [ { "test_id": 1 }, { "test_id": 2 } ]
}

