# =============================================================================
# Doctor — All Operations — Doctoralia
# =============================================================================
# Base: http://localhost:5000
# Routes: server/routes/doctorRoutes.js + server/controllers/doctorController.js
#         + server/controllers/doctorScheduleController.js + server/utils/scheduleWindow.js
# Auth: JWT Bearer — role "doctor", server/middleware/authMiddleware.js
# Timezone: Asia/Dhaka — window 8:00 PM–12:00 AM (20:00-24:00), dates today→Dec31 (was 1:30 AM–12:00 PM)
#
# HOW TO USE:
#  1. GET /api/departments (public) to get department_id
#  2. POST /api/doctors/apply (public multipart) → admin approves
#  3. POST /api/doctors/login → copy token → paste into @doctorToken
#  4. Every 🔒 block below sends Authorization: Bearer {{doctorToken}}
# =============================================================================

@baseUrl = http://localhost:5000
@doctorToken = PASTE_DOCTOR_JWT_HERE
@adminToken = PASTE_ADMIN_JWT_HERE
# for 3.1b disabled-dept manual check, paste admin token from POST /api/admin/login

# -------------------------------------------------------------------------
# 0. Health — public
# -------------------------------------------------------------------------

### 0.1 Root
GET {{baseUrl}}/

### 0.2 Test DB
GET {{baseUrl}}/api/test-db

# -------------------------------------------------------------------------
# 1. Departments (public — needed for registration dropdown) — now active-only
# -------------------------------------------------------------------------

### 1.1 List active departments — public — GET /api/departments (WHERE status='active' OR NULL)
GET {{baseUrl}}/api/departments

### 1.2 Search — public
GET {{baseUrl}}/api/departments?search=Cardio

### 1.3 Get by ID — public
GET {{baseUrl}}/api/departments/1

# -------------------------------------------------------------------------
# 2. Doctor Auth — public
# -------------------------------------------------------------------------

### 2.1 Register — public — POST /api/doctors/apply — multipart, 5MB, field profile_photo
# Required: department_id (must be active), full_name, email (unique), password, phone_number,
# qualification, specification, medical_registration_no (unique), new_patient_fee, followup_fee, max_patient_num
# Expected 201: { doctor } | 400 inactive dept | 409 dup
POST {{baseUrl}}/api/doctors/apply
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary

------WebKitFormBoundary
Content-Disposition: form-data; name="department_id"

1
------WebKitFormBoundary
Content-Disposition: form-data; name="full_name"

Dr. Arif Rahman
------WebKitFormBoundary
Content-Disposition: form-data; name="email"

arif.rahman@example.com
------WebKitFormBoundary
Content-Disposition: form-data; name="password"

Doctor@123
------WebKitFormBoundary
Content-Disposition: form-data; name="phone_number"

01710000001
------WebKitFormBoundary
Content-Disposition: form-data; name="qualification"

MBBS, FCPS (Medicine)
------WebKitFormBoundary
Content-Disposition: form-data; name="specification"

Cardiology
------WebKitFormBoundary
Content-Disposition: form-data; name="medical_registration_no"

BMDC-2026-0001
------WebKitFormBoundary
Content-Disposition: form-data; name="new_patient_fee"

800
------WebKitFormBoundary
Content-Disposition: form-data; name="followup_fee"

500
------WebKitFormBoundary
Content-Disposition: form-data; name="max_patient_num"

20
------WebKitFormBoundary
Content-Disposition: form-data; name="profile_photo"; filename="doctor.jpg"
Content-Type: image/jpeg

< ./server/uploads/doctors/doctor.jpg
------WebKitFormBoundary--

### 2.2 Login — public — POST /api/doctors/login — ⭐ RETURNS TOKEN
# Checks pending/rejected 403, clears expired suspension. Returns { token, doctor }
# @name doctorLogin
POST {{baseUrl}}/api/doctors/login
Content-Type: application/json

{
  "email": "arif.rahman@example.com",
  "password": "Doctor@123"
}

# -------------------------------------------------------------------------
# 3. Doctor — Profile & Dashboard & Appointments — 🔒 doctor
# -------------------------------------------------------------------------

### 3.1 Get own profile — 🔒 doctor — GET /api/doctors/profile — now returns department_status (active/inactive)
GET {{baseUrl}}/api/doctors/profile
Authorization: Bearer {{doctorToken}}
# Expected 200: { doctor: { doctor_id, department_id, department_name, department_status:"active"|"inactive"|null, ... } }
# If dept disabled → department_status:"inactive" and dashboard shows "Your department is currently disabled." (DoctorDashboard.jsx:1758)

### 3.1a Profile returns department_status — active case (no disable)
GET {{baseUrl}}/api/doctors/profile
Authorization: Bearer {{doctorToken}}
# Assert: response.body.doctor.department_status in ["active", null] when dept enabled

### 3.1b Disabled dept — admin disables, then profile reflects inactive
# Step 1: admin disables department (use admin token) — PUT /api/admin/departments/:id/disable
# PUT {{baseUrl}}/api/admin/departments/1/disable — expect 200 "Department disabled successfully."
# Step 2: same doctor GET {{baseUrl}}/api/doctors/profile — expect department_status:"inactive" → frontend banner
# Step 3: re-enable — PUT {{baseUrl}}/api/admin/departments/1/enable — then GET profile → department_status:"active" → banner hidden
PUT {{baseUrl}}/api/admin/departments/1/disable
Authorization: Bearer {{adminToken}}

### 3.1c Re-enable check — GET profile returns active again
GET {{baseUrl}}/api/doctors/profile
Authorization: Bearer {{doctorToken}}

### 3.2 Dashboard stats — 🔒 doctor — GET /api/doctors/dashboard/stats
GET {{baseUrl}}/api/doctors/dashboard/stats
Authorization: Bearer {{doctorToken}}

### 3.3 List own appointments — 🔒 doctor — GET /api/doctors/appointments
GET {{baseUrl}}/api/doctors/appointments
Authorization: Bearer {{doctorToken}}

### 3.4 Filter by schedule — 🔒 doctor — GET /api/doctors/appointments?schedule_id=1
GET {{baseUrl}}/api/doctors/appointments?schedule_id=1
Authorization: Bearer {{doctorToken}}

### 3.5 Get hospitals — 🔒 doctor — GET /api/doctors/hospitals
GET {{baseUrl}}/api/doctors/hospitals
Authorization: Bearer {{doctorToken}}

